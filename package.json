{
    "name": "etudes2lignes",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Suivi géolocalisé de schémas de ligne ferroviaires — PWA hors ligne",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit",
        "icons": "node scripts/generate-icons.mjs",
        "format": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "fallow": "fallow",
        "fallow:fix": "fallow fix --yes",
        "fallow:check": "fallow fix --dry-run",
        "mutation": "stryker run",
        "quality": "pnpm typecheck && pnpm lint && pnpm test && pnpm exec fallow audit",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,js,mjs,cjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{html,css,json,md,yml,yaml}": "prettier --write"
    },
    "dependencies": {
        "idb": "^8.0.3",
        "leaflet": "^1.9.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.61.1",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/typescript-checker": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@types/leaflet": "^1.9.21",
        "@types/node": "^26.1.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "fake-indexeddb": "^6.2.5",
        "fallow": "^3.5.1",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.0.8",
        "prettier": "^3.9.5",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.63.0",
        "vite": "^8.1.4",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.10",
        "workbox-window": "^7.4.1"
    }
}
